# Fol e ar · exemplo de variables locais para `wrangler dev`.
#
# Copia a .dev.vars (xa ignorado por git) e substitúe os valores. Nunca
# comitear .dev.vars nin ningún ficheiro con segredos reais.

BROWSER_RUN_API_TOKEN=

# Login con Google (ver README.md, sección "Usuarias e roles").
# GOOGLE_CLIENT_ID e ADMIN_EMAILS tamén poden ir en [vars] do wrangler.toml;
# GOOGLE_CLIENT_SECRET só como secret (`wrangler secret put GOOGLE_CLIENT_SECRET`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# Só en desenvolvemento: abre as escrituras sen login.
AUTH_DISABLED=
